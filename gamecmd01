<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Terminal Master v2.0</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;700&display=swap');

        body {
            background-color: #0d0d0d;
            color: #00ff41;
            font-family: 'Fira Code', monospace;
            overflow-x: hidden;
        }

        .terminal-window {
            background-color: #1a1a1a;
            border: 2px solid #333;
            box-shadow: 0 20px 50px rgba(0,0,0,0.8);
            border-radius: 10px;
        }

        .command-btn {
            background: #252526;
            border: 1px solid #3e3e42;
            color: #d4d4d4;
            transition: all 0.15s ease;
        }

        .command-btn:not(:disabled):hover {
            background: #00ff41;
            color: #000;
            border-color: #00ff41;
            transform: translateY(-2px);
        }

        .command-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .correct { background-color: #27c93f !important; color: black !important; border-color: #27c93f !important; }
        .wrong { background-color: #ff5f56 !important; color: black !important; border-color: #ff5f56 !important; }

        .crt-overlay {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.1) 50%), 
                        linear-gradient(90deg, rgba(255, 0, 0, 0.03), rgba(0, 255, 0, 0.01), rgba(0, 0, 255, 0.03));
            background-size: 100% 3px, 3px 100%;
            pointer-events: none;
            z-index: 100;
        }
    </style>
</head>
<body class="min-h-screen flex items-center justify-center p-4">
    <div class="crt-overlay"></div>

    <div id="game-container" class="max-w-4xl w-full z-10">
        <!-- TELA INICIAL -->
        <div id="start-screen" class="text-center space-y-6">
            <h1 class="text-4xl md:text-6xl font-bold tracking-tighter">C:\> TERMINAL_MASTER.EXE</h1>
            <p class="text-green-800 text-lg">Módulo de Treinamento Nível 2 - Ordem Aleatória Habilitada</p>
            <div class="bg-zinc-900 p-4 border border-zinc-700 inline-block text-left text-sm space-y-1">
                <p>> 10 Desafios de Identificação Visual</p>
                <p>> Ordem das perguntas: RANDÔMICA</p>
                <p>> Penalidade por erro: IMEDIATA</p>
            </div>
            <br>
            <button onclick="startGame()" class="mt-4 px-12 py-4 border-2 border-green-500 hover:bg-green-500 hover:text-black font-bold text-xl transition-all">
                AUTENTICAR E INICIAR
            </button>
        </div>

        <!-- TELA DO JOGO -->
        <div id="quiz-screen" class="hidden">
            <div class="flex justify-between items-center mb-4 px-2 text-xs md:text-sm">
                <div class="flex gap-4">
                    <span>SESSÃO: <span id="current-step">1</span>/10</span>
                    <span id="score-display" class="text-yellow-500">ACERTOS: 0</span>
                </div>
                <div id="timer" class="text-green-900">SYS_RUNNING...</div>
            </div>

            <div class="terminal-window">
                <div class="bg-zinc-800 px-4 py-2 flex gap-2 rounded-t-lg">
                    <div class="w-3 h-3 rounded-full bg-red-500"></div>
                    <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
                    <div class="w-3 h-3 rounded-full bg-green-500"></div>
                </div>
                
                <div class="p-6 bg-black min-h-[400px] flex flex-col">
                    <p class="text-xs text-zinc-500 mb-4 italic">// Identifique o comando que gera a saída abaixo:</p>
                    
                    <div id="visual-output" class="flex-grow flex items-center justify-center bg-zinc-950 border border-zinc-800 p-4 rounded mb-6 font-mono text-xs md:text-sm overflow-auto text-center">
                        <!-- Conteúdo dinâmico -->
                    </div>

                    <div id="options-grid" class="grid grid-cols-2 md:grid-cols-3 gap-3">
                        <!-- Botões dinâmicos -->
                    </div>
                </div>
            </div>
        </div>

        <!-- TELA FINAL -->
        <div id="end-screen" class="hidden text-center space-y-6">
            <h2 class="text-5xl font-bold">RELATÓRIO FINAL</h2>
            <div id="final-stats" class="p-8 bg-zinc-900 border-2 border-green-500 rounded-lg inline-block text-left min-w-[300px]">
                <!-- Stats aqui -->
            </div>
            <div>
                <button onclick="location.reload()" class="px-8 py-3 bg-zinc-800 border border-zinc-600 hover:bg-green-600 hover:text-black transition-all">
                    REINICIAR TERMINAL
                </button>
            </div>
        </div>
    </div>

    <script>
        const database = [
            { cmd: "cls", out: `<div class="text-green-500">C:\\Users\\Admin> _</div>`, desc: "Limpa a tela do terminal." },
            { cmd: "dir", out: `<div class="text-gray-300">01/01/2024  10:00    &lt;DIR&gt;          Desktop<br>01/01/2024  10:00    &lt;DIR&gt;          Documents<br>05/02/2024  15:30            4.096 config.sys</div>`, desc: "Lista arquivos com detalhes completos." },
            { cmd: "dir /w", out: `<div class="text-gray-300">[Desktop]   [Documents]   [Music]   [Videos]<br>autoexec.bat   config.sys   readme.txt</div>`, desc: "Lista arquivos em formato largo (colunas)." },
            { cmd: "dir /p", out: `<div class="text-gray-300">... (muitos arquivos acima) ...<br><br><span class="animate-pulse">Pressione qualquer tecla para continuar . . .</span></div>`, desc: "Lista arquivos pausando a cada tela." },
            { cmd: "ver", out: `<div class="text-gray-300">Microsoft Windows [Versão 10.0.19045.3803]</div>`, desc: "Mostra a versão do Windows." },
            { cmd: "vol", out: `<div class="text-gray-300">O volume na unidade C é Sistema<br>O Número de Série do Volume é 1A2B-3C4D</div>`, desc: "Mostra o rótulo do volume do disco." },
            { cmd: "date", out: `<div class="text-gray-300">A data atual é: seg 11/05/2026<br>Digite a nova data: (dd-mm-aa)</div>`, desc: "Mostra/altera a data." },
            { cmd: "time", out: `<div class="text-gray-300">A hora atual é: 14:30:05,12<br>Digite a nova hora:</div>`, desc: "Mostra/altera a hora." },
            { cmd: "exit", out: `<div class="text-red-500 border border-red-900 p-4 text-center font-bold">O processo foi encerrado com o código 0.<br>[Janela Fechada]</div>`, desc: "Fecha o prompt de comando." },
            { cmd: "help", out: `<div class="text-gray-400">ASSOC    Exibe ou modifica associações de extensões.<br>ATTRIB   Exibe ou altera atributos de arquivos.<br>BREAK    Define ou limpa a verificação estendida...</div>`, desc: "Fornece informações de ajuda para comandos do Windows." }
        ];

        let gameQuestions = [];
        let currentIndex = 0;
        let score = 0;
        const commandsList = ["cls", "dir", "dir /w", "dir /p", "ver", "vol", "date", "time", "exit", "help"];

        function startGame() {
            // Embaralhar as questões
            gameQuestions = [...database].sort(() => Math.random() - 0.5);
            document.getElementById('start-screen').classList.add('hidden');
            document.getElementById('quiz-screen').classList.remove('hidden');
            loadQuestion();
        }

        function loadQuestion() {
            const q = gameQuestions[currentIndex];
            document.getElementById('current-step').innerText = currentIndex + 1;
            document.getElementById('visual-output').innerHTML = q.out;
            
            const grid = document.getElementById('options-grid');
            grid.innerHTML = '';
            
            // Embaralhar as opções de botões também para dificultar
            const shuffledOptions = [...commandsList].sort(() => Math.random() - 0.5);

            shuffledOptions.forEach(cmd => {
                const btn = document.createElement('button');
                btn.className = 'command-btn py-3 px-2 rounded font-bold text-xs uppercase';
                btn.innerText = cmd;
                btn.onclick = () => checkAnswer(cmd, btn);
                grid.appendChild(btn);
            });
        }

        function checkAnswer(selected, btn) {
            const correct = gameQuestions[currentIndex].cmd;
            const btns = document.querySelectorAll('.command-btn');
            
            // Desabilitar todos os botões após o clique
            btns.forEach(b => b.disabled = true);

            if (selected === correct) {
                btn.classList.add('correct');
                score++;
                document.getElementById('score-display').innerText = `ACERTOS: ${score}`;
            } else {
                btn.classList.add('wrong');
                // Destacar o correto
                btns.forEach(b => {
                    if (b.innerText === correct) b.classList.add('correct');
                });
            }

            setTimeout(() => {
                currentIndex++;
                if (currentIndex < gameQuestions.length) {
                    loadQuestion();
                } else {
                    finishGame();
                }
            }, 1800);
        }

        function finishGame() {
            document.getElementById('quiz-screen').classList.add('hidden');
            document.getElementById('end-screen').classList.remove('hidden');
            
            const performance = (score / 10) * 100;
            let rank = "";
            let colorClass = "";

            if (score === 10) {
                rank = "SISTEMA INTEGRAL (ADMIN)";
                colorClass = "text-green-500";
            } else if (score >= 7) {
                rank = "USUÁRIO POWER";
                colorClass = "text-blue-400";
            } else if (score >= 5) {
                rank = "SUPORTE TÉCNICO";
                colorClass = "text-yellow-500";
            } else {
                rank = "ESTAGIÁRIO";
                colorClass = "text-red-500";
            }

            document.getElementById('final-stats').innerHTML = `
                <p class="${colorClass} text-xl font-bold mb-2">${rank}</p>
                <div class="my-4 h-px bg-zinc-700 w-full"></div>
                <p class="text-3xl font-bold mb-1">${score} / 10 ACERTOS</p>
                <p class="text-zinc-500 text-sm mb-4">Precisão de Dados: ${performance}%</p>
                <div class="bg-black p-3 border border-zinc-800 text-xs text-red-500 font-mono">
                    <p>> O processo foi encerrado com o código 0.</p>
                    <p>> [Janela Fechada]</p>
                </div>
            `;
        }
    </script>
</body>
</html>
